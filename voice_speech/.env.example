# Gemini API Key (Required for Real-Time Voice)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede

# Voice Turn Detection (VAD)
VAD_PREFIX_PADDING_MS=50
VAD_SILENCE_DURATION_MS=120
VAD_START_SENSITIVITY=START_SENSITIVITY_HIGH
VAD_END_SENSITIVITY=END_SENSITIVITY_HIGH

# Server & Rate Limiting
MAX_CONCURRENT_SESSIONS=5
CIRCUIT_BREAKER_COOLDOWN_SEC=45
LOG_LEVEL=INFO

# Optional: Real-Time Web Grounding & Search
# Tavily Search API key (Free tier available at https://tavily.com - recommended for rich AI context)
TAVILY_API_KEY=

# Optional: NewsAPI.org key (Optional alternative; defaults to Google News RSS if unset)
NEWS_API_KEY=

# RAG Knowledge Subsystem (MongoDB Database Connection for internal facts)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=riva_knowledge
MONGODB_COLLECTION=knowledge_documents
GEMINI_RAG_MODEL=gemini-flash-lite-latest
