# ==============================================================================
# RAG Knowledge Subsystem - Environment Configuration Example
# ==============================================================================
# Copy this file to .env in your root directory or provide these in your environment.
# Note: If GEMINI_API_KEY is omitted, the system seamlessly falls back to 
# returning structured factual knowledge directly without failing.

# Google Gemini API Key for conversational answer synthesis
# Obtain your free API key at Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database Connection (Required for vector retrieval)
# Obtain cluster endpoint & API key from Qdrant Cloud (https://cloud.qdrant.io/) or local container
QDRANT_URL=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_WRITE_API_KEY=your_qdrant_write_api_key_here
QDRANT_COLLECTION=riva_knowledge

# Embedding Model (Optional, defaults to BAAI/bge-small-en-v1.5 via FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Gemini Model ID (Optional, defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest

# Timeouts in seconds (Optional, defaults to 15.0 / 20.0 to prevent WAN ReadTimeout)
QDRANT_TIMEOUT=15.0
GEMINI_TIMEOUT=20.0

# Retrieval & Synthesis Tuning (Optional)
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.40
# RAG_CONTEXT_MIN_SCORE=50.0
# GEMINI_MAX_OUTPUT_TOKENS=1500
# GEMINI_TEMPERATURE=0.2

# Legacy lowercase variable names (also supported for backward compatibility):
# qdrant_cluster_endpoint=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
# qdrant_api=your_qdrant_api_key_here

# Allow loading .env from current working directory (Optional, defaults to false)
# RAG_LOAD_CWD_ENV=false
