PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=riva-voice-gateway
ENVIRONMENT=development

# Voice Gateway Gemini API Key (Required for voice interface)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede

# Level 1: Core Orchestrator
GEMINI_API_KEY_ORCHESTRATOR=your_orchestrator_gemini_key_here

# Level 2: Middleware / Managers
GEMINI_API_KEY_INTENT=your_intent_gemini_key_here
GEMINI_API_KEY_PLANNER=your_planner_gemini_key_here
GEMINI_API_KEY_EXECUTOR=your_executor_gemini_key_here
GEMINI_API_KEY_REVIEWER=your_reviewer_gemini_key_here

# Level 3: Specialized Task-Doers
GEMINI_API_KEY_CODER=your_coder_gemini_key_here
GEMINI_API_KEY_RESEARCHER=your_researcher_gemini_key_here
GEMINI_API_KEY_WRITER=your_writer_gemini_key_here
GEMINI_API_KEY_REASONER=your_reasoner_gemini_key_here
GEMINI_API_KEY_WORKER_5=your_worker_5_gemini_key_here
GEMINI_API_KEY_WORKER_6=your_worker_6_gemini_key_here
GEMINI_API_KEY_WORKER_7=your_worker_7_gemini_key_here
GEMINI_API_KEY_WORKER_8=your_worker_8_gemini_key_here
GEMINI_API_KEY_WORKER_9=your_worker_9_gemini_key_here
GEMINI_API_KEY_WORKER_10=your_worker_10_gemini_key_here